include partial/head
  link(rel="stylesheet", href="/css/index.css")
  link(rel="stylesheet", href="/css/navBar.css")
  link(rel="stylesheet", href="/css/preview.css")
  link(rel="stylesheet", href="/css/previewForms.css")
  title= 'Nimbusdrive'
body(class='previewBody')
  include partial/nav
  .wrapper
    main(id='preview' class='glass')
      .fileContainer
        .fileHeader
          .title
            h1=file.name 
          .fileTools
            a(href=file.source , download=file.name target='_blank'): img(src='/icons/download(2).png')
            button(class='fakeBtn shareBtn'): img(src='/icons/external-link-fill.png')
            button(type='button', class='fakeBtn delBtn'): img(src='/icons/bin.png')
        if (file.extension === 'jpg' || file.extension === 'png' || file.extension === 'webp')
          .file
            img(src=file.source)
        else
          .previewFail
            .blur
            p=`Can't preview ${file.extension} files`
            a(href=file.source , download=file.name, target='_blank') Click here to download
  include partial/footer
  #curtain.invisible
    include partial/shareFile 
    include partial/deleteFile 

  script(src='/scripts/previewForms.js')
