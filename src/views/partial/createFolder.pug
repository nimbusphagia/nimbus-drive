form(method='post', action=`/drive/${currentFolder.id}/createFolder`, class='createFolder form invisible')
  div(class='formTitle')
    h1 New folder
  .formItem 
    label(for='name') Folder name:
    input(id='name', type='text', name="name", maxlength="30" required) 
  div(class='formButtons')
    button(type='submit', class='btn') Add 
      
