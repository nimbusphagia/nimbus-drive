form(method='post', action=`/drive/${currentFolder.id}/editFolder`, class='editFolder form invisible')
  div(class='formTitle')
    h1 Rename folder
  .formItem 
    label(for='name') Folder name:
    input(id='name', type='text', name="name", maxlength="100", required, value=currentFolder.name) 
  div(class='formButtons')
    button(type='submit', class='btn') Edit 
 
