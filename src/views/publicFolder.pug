-const publicFile = (file) => `${baseUrl}/public/file/${file.publicUrl.hash}`;
-const publicFolder = (folder)=>`${baseUrl}/public/folder/${folder.publicUrl.hash}`;

include partial/head
  link(rel="stylesheet", href="/css/index.css")
  link(rel="stylesheet", href="/css/navBar.css")
  link(rel="stylesheet", href="/css/main.css")
  link(rel="stylesheet", href="/css/mainForms.css")
  title= 'Nimbusdrive'
body(class='dashboardBody bgBody')
  include partial/publicNav
  .wrapper
    main(id='main')
      .mainHeader 
        .path
          .pathName
            h1= folder.name
        .mainTools
      .mainContainer
        if(folders)
          each child in folders
            div(class='node folder')
              a(href=publicFolder(child))
                img(src='/icons/files.png')
                p(class='nodeName')=child.name
        if(files)
          each file in files
            div(class='node file')
              a(href=`/public/file/${file.publicUrl.hash}`)
                if (file.extension === 'jpg' || file.extension === 'png' || file.extension === 'webp')
                  img(src='/icons/image.png')
                else
                  img(src='/icons/document.png')
                p(class='nodeName')=trimTitle(file.name) + '.' + file.extension
  include partial/footer
  
