mixin list(nodes, contClass)
  ul(class=`treeBlock ${contClass}`)
    each folder in nodes
      li.treeLvl
        if(folder.parentId == null)
          div(class='treeFolder' id='treeRoot')
            img.arrowIcon(src='/icons/down-yellow.png')
            a(href=`/drive/${folder.id}` class='rotated')= folder.name
        else
          div(class=`treeFolder ${folder.id === currentFolder.id ? 'currentFolder' : ''}`)
            img.arrowIcon(src='/icons/down-purple.png')
            a(href=`/drive/${folder.id}`)= folder.name

        if folder.children && folder.children.length
          +list(folder.children, '')

include partial/head
  link(rel="stylesheet", href="/css/index.css")
  link(rel="stylesheet", href="/css/navBar.css")
  link(rel="stylesheet", href="/css/main.css")
  link(rel="stylesheet", href="/css/mainForms.css")
  title= 'Nimbusdrive'
body(class='dashboardBody bgBody')
  include partial/nav
  .wrapper
    div(id='sideBar' class='glass')
      .sideTools
        button(type='button', class='treeBtn btn') New folder
      .treeContainer
        +list(folders, '')
    main(id='main')
      .mainHeader 
        .path
          .pathName
            h1= currentFolder.name
          .pathBtns
            button(type='button', class='fakeBtn editBtn'): img(src='/icons/pen.png')
            if(currentFolder.parentId != null)
              button(type='button', class='fakeBtn deleteBtn'): img(src='/icons/bin.png')
        .mainTools
          button(type='button', class='newBtn toolBtn btn') Upload 
          button(type='button', class='shareBtn toolBtn btn') Share
      .mainContainer
        if(currentFolder.folders)
          each folder in currentFolder.folders
            div(class='node folder')
              a(href=`/drive/${folder.id}`)
                img(src='/icons/files.png')
                p(class='nodeName')=folder.name
        if(currentFolder.files)
          each file in currentFolder.files
            div(class='node file')
              a(href=`/preview/${file.id}`)
                if (file.extension === 'jpg' || file.extension === 'png' || file.extension === 'webp')
                  img(src='/icons/image.png')
                else
                  img(src='/icons/document.png')
                p(class='nodeName')=trimTitle(file.name) + '.' + file.extension
  include partial/footer
  #curtain.invisible
    include partial/createFolder 
    include partial/editFolder 
    include partial/shareFolder 
    include partial/deleteFolder 
    include partial/createFile 
  include partial/loading
  script(src='/scripts/utilities.js')
  script(src='/scripts/treeView.js')
  script(src='/scripts/mainForms.js')
